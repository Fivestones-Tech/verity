# Copy to .env.local and fill in. Never commit real values.
# Public (safe for the browser): Supabase project URL and anon/publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: service role key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Domain used to build internal login addresses for students who sign in with
# centre code + student number. Must be a domain you control or a reserved one.
STUDENT_LOGIN_DOMAIN=students.verity.invalid
# Optional: when set, registering a centre requires this code (closed pilot)
CENTRE_SIGNUP_CODE=
# Early Access payments (Paystack). Server only. Use the test key (sk_test_...) on
# staging and the live key (sk_live_...) in production. Leave empty to switch online
# payment off. Paystack webhook URL: https://<your site>/api/v1/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
# Centre code of Verity's own online centre, which students who sign up on their own
# join (e.g. VERITY). Leave empty to keep self sign-up closed.
ONLINE_CENTRE_CODE=
# Optional: public site address used for the Paystack return link, e.g. https://verity.ng
SITE_URL=
